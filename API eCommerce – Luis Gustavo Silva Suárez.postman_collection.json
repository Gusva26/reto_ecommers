              "let jsonData = pm.response.json();\r\npm.environment.set(\"product_id\", jsonData.products[0].id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/products",
          "host": [
